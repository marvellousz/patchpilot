# Models to use, in order of preference, as provider:model. When one hits its free-tier
# rate limit the next is used (limits are per model, so rotating multiplies throughput).
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash

GEMINI_API_KEY=
GROQ_API_KEY=

# GitHub token with Issues + Contents + Pull requests read/write on the target repo
GITHUB_TOKEN=

# Webhook (patchpilot serve): the secret set on the GitHub webhook, and the label that starts a run
GITHUB_WEBHOOK_SECRET=
PATCHPILOT_LABEL=patchpilot
# Optional: encryption key for stored GitHub tokens (generated into data/secret.key if unset)
PATCHPILOT_SECRET_KEY=
# Public demo: invite code required to sign up (unset = open sign-up), and runs per account per 24h (0 = no limit)
PATCHPILOT_INVITE_CODE=
PATCHPILOT_RUNS_PER_DAY=5
